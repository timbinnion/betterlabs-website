---
import SectionPlaceholder from '../components/SectionPlaceholder.astro';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
  <header class="site-container section-spacing">
    <p>(better)labs</p>
    <h1>Company website coming soon</h1>
    <p>
      This placeholder confirms the Astro, TypeScript, and Tailwind foundation is
      ready for the landing page design.
    </p>
  </header>

  <SectionPlaceholder
    id="services"
    heading="Services"
    description="Future home of the sustainable design, strategy, and education offer."
  />
  <SectionPlaceholder
    id="projects"
    heading="Selected projects"
    description="Future home of the project carousel."
  />
  <SectionPlaceholder
    id="clients"
    heading="Clients"
    description="Future home of client logos and credibility."
  />
  <SectionPlaceholder
    id="about"
    heading="About"
    description="Future home of the (better)labs introduction."
  />
  <SectionPlaceholder
    id="contact"
    heading="Contact"
    description="Future home of the primary call to action."
  />
</MainLayout>
