---
import type { HomepageContent } from '../data/homepage';
import {
  localeLabels,
  localePaths,
  supportedLocales,
  type Locale,
} from '../data/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SectionPlaceholder from './SectionPlaceholder.astro';

interface Props {
  content: HomepageContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const languageOptions = supportedLocales.map((optionLocale) => ({
  locale: optionLocale,
  label: localeLabels[optionLocale],
  href: localePaths[optionLocale],
}));
---

<header class="site-container section-spacing">
  <p>{content.hero.eyebrow}</p>
  <LanguageSwitcher
    ariaLabel={content.ui.languageSwitcherLabel}
    currentLocale={locale}
    options={languageOptions}
  />
  <h1>{content.hero.headline[0]}</h1>
  <p>{content.hero.body}</p>
</header>

<SectionPlaceholder
  id="questions"
  heading={content.questions.title}
  description={content.questions.eyebrow}
/>
<SectionPlaceholder
  id="services"
  heading={content.services.title}
  description={content.services.eyebrow}
/>
<SectionPlaceholder
  id="projects"
  heading={content.projects.title}
  description={content.projects.eyebrow}
/>
<SectionPlaceholder
  id="audiences"
  heading={content.audiences.title}
  description={content.audiences.eyebrow}
/>
<SectionPlaceholder
  id="clients"
  heading={content.clients.eyebrow}
  description={content.clients.names.join(' · ')}
/>
<SectionPlaceholder
  id="about"
  heading={content.about.statement}
  description={content.about.body}
/>
<SectionPlaceholder
  id="contact"
  heading={content.cta.headline}
  description={content.cta.body}
/>
