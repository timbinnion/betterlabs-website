---
import type { HomepageContent } from '../data/homepage';
import type { Locale } from '../data/site';
import AboutSection from './AboutSection.astro';
import AudiencesSection from './AudiencesSection.astro';
import FinalCta from './FinalCta.astro';
import HeroSection from './HeroSection.astro';
import ProjectCarousel from './ProjectCarousel.astro';
import QuestionsSection from './QuestionsSection.astro';
import ServicesSection from './ServicesSection.astro';
import WorkshopSection from './WorkshopSection.astro';

interface Props {
  content: HomepageContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
---

<HeroSection content={content} locale={locale} />
<QuestionsSection content={content.questions} />
<ServicesSection content={content.services} />
<ProjectCarousel content={content.projects} />
<WorkshopSection content={content.workshops} />
<AudiencesSection content={content.audiences} />
<AboutSection clients={content.clients} about={content.about} />
<FinalCta content={content.cta} />
