---
import type { ClientsContent } from '../data/types';

interface Props {
  content: ClientsContent;
}

const { content } = Astro.props;
const visibleClients = content.items.filter((client) => client.visible !== false);
---

<div class="flex flex-col items-start gap-7 pb-[38px] lg:flex-row lg:items-center lg:gap-8">
  <p class="eyebrow shrink-0 lg:w-[152px]">{content.eyebrow}</p>

  <div
    class="client-marquee min-w-0 w-full overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-green lg:flex-1"
    role="region"
    aria-label={content.eyebrow}
    tabindex="0"
  >
    <div class="client-marquee-track flex w-max items-center">
      <ul class="client-logo-sequence flex shrink-0 list-none items-center gap-10 p-0 pr-10 md:gap-12 md:pr-12 lg:gap-16 lg:pr-16">
        {
          visibleClients.map((client) => (
            <li class="flex shrink-0 items-center justify-center">
              <img
                src={client.image.src}
                alt={client.image.alt}
                title={client.name}
                width="423"
                height="423"
                class="h-[34px] w-auto max-w-none object-contain md:h-[38px] lg:h-[42px]"
              />
            </li>
          ))
        }
      </ul>

      <ul
        class="client-logo-sequence client-logo-sequence-copy flex shrink-0 list-none items-center gap-10 p-0 pr-10 md:gap-12 md:pr-12 lg:gap-16 lg:pr-16"
        aria-hidden="true"
      >
        {
          visibleClients.map((client) => (
            <li class="flex shrink-0 items-center justify-center">
              <img
                src={client.image.src}
                alt=""
                width="423"
                height="423"
                class="h-[34px] w-auto max-w-none object-contain md:h-[38px] lg:h-[42px]"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .client-marquee-track {
    animation: client-marquee 48s linear infinite;
    will-change: transform;
  }

  .client-marquee:hover .client-marquee-track,
  .client-marquee:focus-within .client-marquee-track {
    animation-play-state: paused;
  }

  @keyframes client-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-marquee {
      overflow: visible;
    }

    .client-marquee-track {
      width: 100%;
      animation: none;
      transform: none;
      will-change: auto;
    }

    .client-logo-sequence {
      width: 100%;
      flex-wrap: wrap;
      row-gap: 1.5rem;
    }

    .client-logo-sequence-copy {
      display: none;
    }
  }
</style>
