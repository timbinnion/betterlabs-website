---
import type { ContactFormContent } from '../data/types';
import type { Locale } from '../data/site';

interface Props {
  content: ContactFormContent;
  locale: Locale;
  formId?: string;
}

const { content, locale, formId = 'contact-form' } = Astro.props;
const fieldId = (name: string) => `${formId}-${name}`;
---

<form
  id={formId}
  action="/api/contact"
  method="post"
  class="relative grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2"
  data-contact-form
  data-locale={locale}
  data-submitting-message={content.submittingLabel}
  data-success-message={content.successMessage}
  data-error-message={content.errorMessage}
>
  <div class="col-span-full flex items-start justify-between gap-6 border-b border-white/40 pb-5">
    <p class="text-xs font-medium leading-[1.2] tracking-[-0.015em] text-white/80">
      {content.requiredHint}
    </p>
    <button
      type="button"
      class="shrink-0 text-xs font-bold leading-[1.2] text-white underline decoration-white/60 underline-offset-4 hover:decoration-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      data-contact-close
    >
      {content.closeLabel}
    </button>
  </div>

  <input
    type="text"
    name="_gotcha"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="pointer-events-none absolute -left-[10000px] size-px opacity-0"
  />

  <div class="form-field">
    <label for={fieldId('name')} class="form-label">{content.nameLabel}</label>
    <input
      id={fieldId('name')}
      name="name"
      type="text"
      autocomplete="name"
      required
      class="form-control"
    />
  </div>

  <div class="form-field">
    <label for={fieldId('organisation')} class="form-label">
      {content.organisationLabel}
    </label>
    <input
      id={fieldId('organisation')}
      name="organisation"
      type="text"
      autocomplete="organization"
      required
      class="form-control"
    />
  </div>

  <div class="form-field">
    <label for={fieldId('email')} class="form-label">{content.emailLabel}</label>
    <input
      id={fieldId('email')}
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      class="form-control"
    />
  </div>

  <div class="form-field">
    <label for={fieldId('project-type')} class="form-label">
      {content.projectTypeLabel}
    </label>
    <select
      id={fieldId('project-type')}
      name="projectType"
      required
      class="form-control cursor-pointer"
    >
      <option value="" disabled selected>{content.projectTypePlaceholder}</option>
      {
        content.projectTypeOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))
      }
    </select>
  </div>

  <div class="form-field col-span-full">
    <label for={fieldId('message')} class="form-label">{content.messageLabel}</label>
    <textarea
      id={fieldId('message')}
      name="message"
      rows="4"
      minlength="10"
      required
      class="form-control min-h-28 resize-y"
    ></textarea>
  </div>

  <div class="col-span-full pt-1">
    <button
      type="submit"
      class="inline-flex min-h-[49px] items-center gap-2.5 rounded-full border border-white bg-transparent px-[22px] py-[14px] text-[15px] font-bold leading-[1.2] tracking-[-0.015em] text-white transition-colors hover:bg-white hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      data-submit-button
    >
      <span data-submit-label>{content.submitLabel}</span>
      <span aria-hidden="true" class="text-base">↗</span>
    </button>
  </div>

  <p
    class="col-span-full hidden border-t border-white/40 pt-5 text-[15px] font-semibold leading-[1.4]"
    role="status"
    aria-live="polite"
    tabindex="-1"
    data-form-status
  ></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const initialSubmitLabel = submitLabel?.textContent ?? '';
    let submitting = false;

    const showStatus = (message: string) => {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden');
      status.focus({ preventScroll: true });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (submitting) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitting = true;
      submitButton?.setAttribute('disabled', '');
      submitButton?.setAttribute('aria-busy', 'true');
      if (submitLabel) {
        submitLabel.textContent = form.dataset.submittingMessage ?? initialSubmitLabel;
      }
      status?.classList.add('hidden');

      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        payload.locale = form.dataset.locale ?? 'en';

        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) throw new Error('Form submission failed');

        form.reset();
        showStatus(form.dataset.successMessage ?? '');
      } catch {
        showStatus(form.dataset.errorMessage ?? '');
      } finally {
        submitting = false;
        submitButton?.removeAttribute('disabled');
        submitButton?.removeAttribute('aria-busy');
        if (submitLabel) submitLabel.textContent = initialSubmitLabel;
      }
    });
  });
</script>
