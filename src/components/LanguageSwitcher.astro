---
import type { Locale } from '../data/site';

interface LanguageOption {
  locale: Locale;
  languageTag: string;
  label: string;
  href: string;
}

interface Props {
  ariaLabel: string;
  currentLocale: Locale;
  options: LanguageOption[];
}

const { ariaLabel, currentLocale, options } = Astro.props;
---

<nav aria-label={ariaLabel} class="shrink-0">
  <ul class="flex list-none gap-2 p-0 text-[11px] font-bold uppercase tracking-[-0.015em] text-white">
    {
      options.map((option) => (
        <li>
          <a
            href={option.href}
            lang={option.languageTag}
            hreflang={option.languageTag}
            aria-current={option.locale === currentLocale ? 'page' : undefined}
            class:list={[
              'rounded-full border px-2 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white',
              option.locale === currentLocale
                ? 'language-link-active border-white bg-white'
                : 'border-white/50 hover:border-white',
            ]}
          >
            {option.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .language-link-active {
    color: var(--color-ink);
  }
</style>
