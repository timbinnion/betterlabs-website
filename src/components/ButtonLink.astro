---
import type { LinkContent } from '../data/types';

interface Props {
  link: LinkContent;
  variant?: 'primary' | 'outline';
}

const { link, variant = 'primary' } = Astro.props;
const variantClasses = {
  primary:
    'border-brand-green bg-brand-green text-ink hover:bg-white hover:border-white',
  outline:
    'border-white bg-transparent text-white hover:bg-white hover:text-ink',
};
---

<a
  href={link.href}
  class:list={[
    'inline-flex min-h-[49px] items-center gap-2.5 rounded-full border px-[22px] py-[14px] text-[15px] font-bold leading-[1.2] tracking-[-0.015em] transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white',
    variantClasses[variant],
  ]}
>
  <span>{link.label}</span>
  <span aria-hidden="true" class="text-base">↗</span>
</a>
