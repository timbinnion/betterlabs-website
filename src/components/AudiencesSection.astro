---
import type { AudiencesContent } from '../data/types';

interface Props {
  content: AudiencesContent;
}

const { content } = Astro.props;
---

<section aria-labelledby="audiences-title" class="bg-warm">
  <div class="site-container min-h-[792px] py-[112px]">
    <p class="eyebrow">{content.eyebrow}</p>
    <h2 id="audiences-title" class="mt-[50px] max-w-[950px] text-[52px] font-semibold leading-[1.08] tracking-[-0.015em]">
      {content.title}
    </h2>
    <ol class="mt-[50px] grid list-none grid-cols-1 gap-[22px] p-0 md:grid-cols-3">
      {
        content.items.map((audience, index) => (
          <li class="min-h-[318px] bg-white px-[26px] pb-[34px] pt-7">
            <p class="eyebrow">{String(index + 1).padStart(2, '0')}</p>
            <img
              src={audience.icon}
              alt=""
              width="88"
              height="88"
              class="mt-4 size-[88px] rounded-full"
            />
            <h3 class="mt-4 max-w-[345px] text-[27px] font-semibold leading-[1.1] tracking-[-0.015em]">
              {audience.title}
            </h3>
            <p class="mt-4 max-w-[345px] text-base leading-[1.45] tracking-[-0.015em] text-muted">
              {audience.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
