---
import type { CtaContent } from '../data/types';
import { site } from '../data/site';
import ContactForm from './ContactForm.astro';
import Logo from './Logo.astro';

interface Props {
  content: CtaContent;
}

const { content } = Astro.props;
---

<section id="contact" aria-labelledby="contact-title" class="relative isolate min-h-[746px] overflow-hidden bg-brand-green text-white">
  <img
    src="/images/cta/cta-background.png"
    alt=""
    width="1440"
    height="746"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#d7df23_0%,#8dc63f_48%,#39b54a_100%)] mix-blend-multiply"
  ></div>

  <div class="site-container flex min-h-[746px] flex-col py-16 lg:py-20">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(480px,1.05fr)] lg:gap-20">
      <div>
        <p class="eyebrow text-white">{content.eyebrow}</p>
        <h2 id="contact-title" class="mt-7 max-w-[620px] text-[clamp(3rem,4.5vw,68px)] font-semibold leading-[1.05] tracking-[-0.015em]">
          {content.headline}
        </h2>
        <p class="mt-7 max-w-[566px] text-[19px] leading-[1.4] tracking-[-0.015em]">
          {content.body}
        </p>
      </div>

      <ContactForm content={content.form} />
    </div>

    <footer class="mt-16 flex flex-col items-start justify-between gap-6 border-t border-white/40 pt-8 sm:flex-row sm:items-end lg:mt-auto">
      <Logo label={site.name} />
      <p class="text-xs font-medium leading-[1.2] tracking-[-0.015em]">{content.footerMeta}</p>
    </footer>
  </div>
</section>
