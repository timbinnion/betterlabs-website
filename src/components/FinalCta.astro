---
import type { CtaContent } from '../data/types';
import { site } from '../data/site';
import ContactForm from './ContactForm.astro';
import Logo from './Logo.astro';

interface Props {
  content: CtaContent;
}

const { content } = Astro.props;
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="relative isolate min-h-[746px] overflow-hidden bg-brand-green text-white"
  data-contact-cta
>
  <img
    src="/images/cta/cta-background.png"
    alt=""
    width="1440"
    height="746"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#d7df23_0%,#8dc63f_48%,#39b54a_100%)] mix-blend-multiply"
  ></div>

  <div class="site-container flex min-h-[746px] flex-col py-[122px]">
    <div>
      <p class="eyebrow text-white">{content.eyebrow}</p>
      <h2 id="contact-title" class="mt-7 max-w-[733px] text-[clamp(3rem,4.75vw,68px)] font-semibold leading-[1.05] tracking-[-0.015em]">
        {content.headline}
      </h2>
      <p class="mt-7 max-w-[566px] text-[19px] leading-[1.4] tracking-[-0.015em]">
        {content.body}
      </p>

      <button
        type="button"
        class="mt-7 inline-flex min-h-[49px] items-center gap-2.5 rounded-full border border-white bg-transparent px-[22px] py-[14px] text-[15px] font-bold leading-[1.2] tracking-[-0.015em] text-white transition-colors hover:bg-white hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        aria-expanded="false"
        aria-controls="contact-form-panel"
        data-contact-open
      >
        <span>{content.action.label}</span>
        <span aria-hidden="true" class="text-base">↗</span>
      </button>
    </div>

    <div
      id="contact-form-panel"
      class="contact-panel"
      aria-hidden="true"
      data-contact-panel
    >
      <div class="overflow-hidden">
        <div class="max-w-[900px] pt-12">
          <ContactForm content={content.form} action={formspreeEndpoint} />
        </div>
      </div>
    </div>

    <footer class="mt-auto flex flex-col items-start justify-between gap-6 pt-14 sm:flex-row sm:items-end">
      <Logo label={site.name} />
      <p class="text-xs font-medium leading-[1.2] tracking-[-0.015em]">{content.footerMeta}</p>
    </footer>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact-cta]').forEach((cta) => {
    const openButton = cta.querySelector<HTMLButtonElement>('[data-contact-open]');
    const closeButton = cta.querySelector<HTMLButtonElement>('[data-contact-close]');
    const panel = cta.querySelector<HTMLElement>('[data-contact-panel]');
    const firstField = cta.querySelector<HTMLInputElement>(
      '[data-contact-form] input:not([tabindex="-1"])',
    );

    const setOpen = (open: boolean) => {
      cta.toggleAttribute('data-form-open', open);
      openButton?.setAttribute('aria-expanded', String(open));
      panel?.setAttribute('aria-hidden', String(!open));

      if (open) {
        window.setTimeout(() => firstField?.focus({ preventScroll: true }), 350);
      } else {
        openButton?.focus({ preventScroll: true });
      }
    };

    openButton?.addEventListener('click', () => setOpen(true));
    closeButton?.addEventListener('click', () => setOpen(false));

    cta.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && cta.hasAttribute('data-form-open')) {
        setOpen(false);
      }
    });
  });
</script>
