---
import type { AboutContent, ClientsContent } from '../data/types';
import ClientMarquee from './ClientMarquee.astro';

interface Props {
  clients: ClientsContent;
  about: AboutContent;
}

const { clients, about } = Astro.props;
---

<section id="about" aria-labelledby="about-title" class="scroll-mt-8 bg-white">
  <div class="site-container py-20 md:py-24 lg:py-[105px]">
    <ClientMarquee content={clients} />

    <div class="grid grid-cols-1 gap-[18px] md:grid-cols-2">
      {
        about.stories.map((story) => (
          <article class="story-card">
            <div class="story-images">
              {
                story.images.map((image) => (
                  <img
                    src={image.src}
                    alt={image.alt}
                    width="322"
                    height="421"
                  />
                ))
              }
            </div>
            <div class="story-caption">
              <h3>{story.title}</h3>
              <p>{story.category}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-[54px] grid grid-cols-1 gap-10 border-t border-divider pt-12 xl:grid-cols-[minmax(0,720px)_minmax(0,390px)] xl:gap-[70px]">
      <div>
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 id="about-title" class="about-heading mt-5 max-w-[720px] text-[clamp(2.25rem,4vw,44px)] font-bold leading-[1.1] tracking-[-0.015em]">
          {about.statement.map((line) => <span class="block">{line}</span>)}
        </h2>
      </div>
      <div>
        <div class="space-y-[18px]">
          {
            about.body.map((paragraph) => (
              <p class="text-[18px] leading-[1.45] tracking-[-0.015em] text-muted">
                {paragraph}
              </p>
            ))
          }
        </div>
        <p class="mt-[18px] text-[15px] font-semibold leading-[1.45] tracking-[-0.015em]">
          {about.founder}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .story-card {
    overflow: hidden;
    background: var(--color-ink);
    color: white;
  }

  .story-images {
    display: grid;
    height: 220px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
  }

  .story-images img {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: cover;
  }

  .story-caption {
    width: 100%;
    background: var(--color-card-dark);
    padding: 18px;
  }

  .story-caption h3 {
    color: white;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
  }

  .story-caption p {
    margin-top: 10px;
    color: var(--color-brand-green);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .story-images {
      height: 270px;
    }

    .story-caption {
      padding: 20px;
    }
  }

  @media (min-width: 1024px) {
    .story-caption {
      padding: 24px;
    }

    .story-caption h3 {
      font-size: 32px;
    }
  }

  @media (max-width: 639px) {
    .about-heading {
      font-size: clamp(22px, 7vw, 36px);
    }
  }
</style>
